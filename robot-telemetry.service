[Unit]
Description=Robot Telemetry Service — Power Play (FRC 4607)
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=simple
WorkingDirectory=REPO_DIR_PLACEHOLDER
EnvironmentFile=REPO_DIR_PLACEHOLDER/.env
ExecStart=REPO_DIR_PLACEHOLDER/bin/python3 REPO_DIR_PLACEHOLDER/run.py
Restart=on-failure
RestartSec=10

# Environment (override DB_URL if needed)
# Environment=RUN_DB_URL=postgresql+psycopg2://user:pass@host:5432/dbname

StandardOutput=journal
StandardError=journal
SyslogIdentifier=robot-telemetry

[Install]
WantedBy=multi-user.target
