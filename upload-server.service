[Unit]
Description=Robot Telemetry Upload Server — Slap Shot (FRC 4607)
After=network.target
Wants=robot-telemetry.service

[Service]
Type=simple
WorkingDirectory=REPO_DIR_PLACEHOLDER
ExecStart=REPO_DIR_PLACEHOLDER/bin/python3 REPO_DIR_PLACEHOLDER/upload_server.py --port 8080
Restart=on-failure
RestartSec=10

StandardOutput=journal
StandardError=journal
SyslogIdentifier=upload-server

[Install]
WantedBy=multi-user.target
