# ── Robot Telemetry Secrets ─────────────────────────────────────────────────
# Copy this file to .env and fill in real values.
# .env is loaded automatically by keys.py and the systemd service.

INFLUX_TOKEN=your-influxdb-token-here
DB_PASSWORD=your-database-password-here
INFLUX_ADMIN_PASS=your-influxdb-admin-password-here
