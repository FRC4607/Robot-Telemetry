      {
        "id": 5,
        "type": "heywesty-trafficlight-panel",
        "title": "Subsystem Health",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "ffd8jczdyabr4c"
        },
        "gridPos": {
          "h": 6,
          "w": 24,
          "x": 0,
          "y": 4
        },
        "targets": [
          {
            "datasource": {
              "type": "grafana-postgresql-datasource",
              "uid": "ffd8jczdyabr4c"
            },
            "rawSql": "SELECT \"group\" AS metric, MAX(stoplight) AS stoplight\nFROM metrics\nWHERE file_name = '${file_name}'\nGROUP BY \"group\"\nORDER BY \"group\";",
            "format": "table",
            "rawQuery": true,
            "refId": "A"
          }
        ],
        "fieldConfig": {
          "defaults": {
            "thresholds": {
              "mode": "absolute",
